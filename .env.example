# ============================================================================
# 1. RUNTIME MODE & AI PROVIDER SWITCH
# Iteration 1 (Local Mac): AI_PROVIDER=ollama
# Iteration 2 (Cloud API): AI_PROVIDER=gemini
# ============================================================================
AI_PROVIDER=ollama

# --- Iteration 1: Local Ollama Configuration (macOS) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HEAVY_MODEL=clef:27b-mxfp8
OLLAMA_FAST_MODEL=clef-flash:9b-mxfp8
# Per-request Ollama timeout in ms (default 300000 = 5 min). Raise only for a slow local model.
# OLLAMA_TIMEOUT_MS=300000

# --- Optional local OpenAI-compatible server (for example, MLX when started) ---
# Set AI_PROVIDER=openai_compatible and configure chat-capable models before preflight.
# Port 8081 avoids the Firestore emulator's default port 8080.
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8081
OPENAI_COMPATIBLE_HEAVY_MODEL=
OPENAI_COMPATIBLE_FAST_MODEL=
# Label shown in the UI and stored in provenance for the local runtime (default "Local AI").
LOCAL_RUNTIME_LABEL=MLX
# Read by mlx-runtime/start.sh only (not by the app): server-side output cap for requests that omit
# max_tokens (default 8192), and the port (default 8081). The app always sends max_tokens itself.
# MLX_MAX_TOKENS=8192
# MLX_PORT=8081

# Set AI_PROVIDER=manual_chat to disable live generation and use validated prompt exchange.

# --- Iteration 2: Google Gemini API Configuration (Production) ---
GEMINI_API_KEY=
GEMINI_HEAVY_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional fixed Gemini thinking budget in tokens. Unset (default) keeps the model's dynamic thinking, which on
# gemini-2.5-flash shares each call's maxOutputTokens (a truncated JSON answer is retried once at double).
# When set, the budget is added on top of each call's limit. 0 turns thinking off (valid for 2.5 Flash and
# Flash-Lite, NOT for 2.5 Pro, whose minimum is 128).
# GEMINI_THINKING_BUDGET=0

# --- Track generation timeouts (all providers; unset = built-in defaults) ---
# One stage = one model call plus its repair retries (3 attempts by default).
# GENERATION_ATTEMPT_TIMEOUT_MS overrides one attempt: default 180000 (3 min) on Gemini; on local providers
# max(240000, 60000 + planned output tokens / 15 tok/s).
# GENERATION_STAGE_TIMEOUT_MS overrides the whole stage (all attempts) and wins over the attempt value.
# Hosting note: the build runs inside the /api/tracks/[id]/generate request, so the hosting request timeout
# (Cloud Run for App Hosting) must exceed the whole build, not just one stage.
# GENERATION_ATTEMPT_TIMEOUT_MS=180000
# GENERATION_STAGE_TIMEOUT_MS=

# ============================================================================
# 2. FIREBASE / GOOGLE CLOUD CONFIGURATION
# In Iteration 1, set NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true (0 cloud setup!)
# ============================================================================
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=logicall-pulse-dev
NEXT_PUBLIC_FIREBASE_API_KEY=demo-logicall-pulse-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=logicall-pulse-dev.appspot.com

# Emulator Host Ports (Used automatically when NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ============================================================================
# 3. ACCESS CONTROL & COST GUARDRAILS
# ============================================================================
ALLOWED_GOOGLE_WORKSPACE_DOMAINS=logicall.io,logicall.live
INITIAL_SUPER_ADMIN_EMAILS=connorleavitt@logicall.io,connorl@logicall.io
MAX_SIM_SESSIONS_PER_USER_PER_DAY=15
# How many right-most X-Forwarded-For entries trusted proxies append (rate-limit client key). Default 2
# (Google Cloud load balancer in front of App Hosting: "<client-ip>, <lb-ip>"). Use 1 behind a single proxy.
# TRUSTED_PROXY_HOPS=2

# Demo replay provider only (AI_PROVIDER=replay): recorded model outputs (default demo-replay/demo.json).
# DEMO_REPLAY_FILE=demo-replay/demo.json

# ============================================================================
# INVITE EMAILS (optional). Without RESEND_API_KEY, invites show a copy-link instead.
# ============================================================================
# RESEND_API_KEY=
# EMAIL_FROM="LogiCall Pulse <pulse@logicall.io>"
# EMAIL_REPLY_TO=
# APP_BASE_URL=http://localhost:3000
