{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "LogiCall Pulse",
        "supportEmail": "connorleavitt@logicall.io"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": {
    "backendId": "logicall-pulse",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".env.local",
      ".env*.local",
      "mlx-runtime",
      "playwright-report",
      "test-results",
      "coverage",
      "demo-recordings",
      "demo-replay",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "firestore-debug.log",
      "ui-debug.log",
      "tests",
      "docs",
      "_gemini_review"
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
