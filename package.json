{
  "name": "logicall-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --project demo-logicall-pulse-rules --only firestore \"vitest run tests/integration\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project logicall-pulse-dev --only auth,firestore,storage",
    "seed:local": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "verify:ollama": "tsx --env-file=.env.local scripts/verify-ollama.ts",
    "dev:local": "npm run verify:ollama && npm run dev"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.1.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
