{
  "name": "logicall-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --project demo-logicall-pulse-rules --only firestore \"vitest run tests/integration tests/rules --no-file-parallelism\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project logicall-pulse-dev --only auth,firestore,storage",
    "seed:local": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "seed:prod": "tsx scripts/seed-prod.ts",
    "seed:prod:dry": "tsx scripts/seed-prod.ts --dry-run",
    "verify:ollama": "tsx --env-file=.env.local scripts/verify-ollama.ts",
    "verify:local-ai": "tsx --env-file=.env.local scripts/verify-local-ai.ts",
    "verify:local-ai:mlx": "sh scripts/with-mlx-env.sh npm run verify:local-ai",
    "verify:usable": "node scripts/verify-usable-product.mjs",
    "verify:usable:offline": "node scripts/verify-usable-product.mjs --offline",
    "export:review": "node scripts/export-review-bundle.mjs",
    "email:preview": "tsx scripts/preview-invite-email.ts",
    "dev:local": "npm run verify:ollama && npm run dev",
    "dev:mlx": "sh scripts/with-mlx-env.sh sh -c 'npm run verify:local-ai && npm run dev'"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.1.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
