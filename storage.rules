rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // How To videos, posters and screenshots: readable by any signed-in user, never written by clients
    // (uploaded with the Admin SDK by `npm run guides:media:upload`; the app serves them via /api/guide-media).
    match /guide-media/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
