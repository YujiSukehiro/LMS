rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // How To media (guide-media/) is read only by the server with the Admin SDK and served through
    // /api/guide-media, which checks the viewer's role. Browsers never read or write Storage directly.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
